{
  "schema_version": 1,
  "mail_v": {
    "10.7": "V2", "10.8": "V2", "10.9": "V2",
    "10.10": "V3", "10.11": "V4", "10.12": "V5",
    "10.13": "V6", "10.14": "V7", "10.15": "V8",
    "11": "V9", "12": "V10", "13": "V10", "14": "V10", "15": "V10"
  },
  "mail_v_default": "V10",
  "macos_names": {
    "10.13": "High Sierra",
    "10.14": "Mojave",
    "10.15": "Catalina",
    "11": "Big Sur",
    "12": "Monterey",
    "13": "Ventura",
    "14": "Sonoma",
    "15": "Sequoia"
  },
  "quick_skip_ids": [
    "xcode_junk", "ios_backups", "docker_junk", "npm_junk", "python_junk",
    "rust_junk", "cpp_junk", "php_junk", "go_junk", "ai_model_cache", "simulator_devices",
    "external_trashes", "docker_build_cache", "docker_unused_images",
    "docker_stopped_containers", "tm_local_snapshots", "tmp_system",
    "system_diagnostics", "sleepimage", "rosetta_cache"
  ],
  "always_protected": [
    "{HOME}/.workbuddy/binaries/python",
    "{HOME}/.local/share/uv/python",
    "{HOME}/.rustup/toolchains",
    "{HOME}/.gradle/wrapper"
  ],
  "dev_dirs": [
    "Projects", "projects", "code", "dev", "Developer",
    "work", "workspace", "Documents", "Desktop", "Downloads"
  ],
  "named_dir_guards": [
    ".venv", "venv", "env", "virtualenv", "node_modules", "vendor",
    "target", "site-packages", "__pycache__", ".git"
  ],
  "docker_cli_candidates": [
    "{HOME}/.docker/bin", "/usr/local/bin", "/opt/homebrew/bin"
  ],
  "cli_defaults": {
    "min_size": 0.0,
    "large_gb": 1.0,
    "old_days": 90,
    "tmp_days": 7,
    "min_kb": 100.0,
    "max_files": 50000,
    "max_hash_mb": 4096.0,
    "similar_threshold": 6,
    "max_images": 2000
  },
  "large_old_files": {
    "id": "large_old_files",
    "name_template": "大文件/旧文件（>%gGB 且 %d天未改）",
    "severity": "caution",
    "scope": "user",
    "desc": "用户目录下超过阈值且久未修改的文件，需人工确认是否删除。",
    "per_item_confirm": false,
    "collector": "large_old",
    "roots": [
      "{HOME}/Downloads",
      "{HOME}/Desktop",
      "{HOME}/Documents",
      "{HOME}/Movies",
      "{HOME}/Music",
      "{HOME}/Pictures",
      "{HOME}"
    ],
    "skip_sub": [
      ".git", "node_modules", "Caches", "Containers", "Application Support",
      "Mail", "Library", ".Trash", "DerivedData"
    ],
    "max_items": 500
  }
}
