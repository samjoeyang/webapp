<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ domain }}#organization",
      "name": "{{ brand_name_en }}（{{ brand_name_zh }}）",
      "alternateName": "{{ brand_name_zh }}",
      "url": "{{ domain }}",
      "logo": "{{ logo }}",
      "description": "{{ brand_description }}",
      "sameAs": [
        "{{ same_as_1 }}",
        "{{ same_as_2 }}"
      ]{{ parent_block }}{{ department_block }}
    }
  ]
}
</script>
